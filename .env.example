OPENAI_API_KEY=sk-your-key-here

INPUT_DEVICE=2
OUTPUT_DEVICE=1

OPENAI_MODEL=gpt-realtime-2.1-mini
WEB_MODEL=gpt-5.6-luna
LINK_SELECTOR_MODEL=gpt-5.6-luna

VOICE=marin

WAKE_THRESHOLD=0.20

CONVERSATION_TIMEOUT=20

CHROMIUM_PATH=/usr/bin/chromium

MAX_SITE_PAGES=5
MAX_SITE_DEPTH=2
MAX_LINKS_FOR_SELECTION=40
SITE_LINKS_PER_STEP=3
MAX_LINK_SELECTION_CALLS=3

DEFAULT_VOLUME=50
DEFAULT_VOLUME_STEP=10

SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_DEVICE_NAME=Scarlett

MPV_PATH=/usr/bin/mpv
RADIO_OUTPUT=raspotify_out
RADIO_DEFAULT_VOLUME=80
